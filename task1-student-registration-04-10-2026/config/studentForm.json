{
  "formName": "Student Management System",
  "fields": [
    {
      "name": "studentName",
      "label": "Student Name",
      "type": "text",
      "required": true,
      "validation": {
        "minLength": 2,
        "maxLength": 50
      },
      "messages": {
        "required": "Student Name is required",
        "minLength": "Student Name must be at least 2 characters",
        "maxLength": "Student Name must not exceed 50 characters"
      }
    },
    {
      "name": "enrollmentNo",
      "label": "Enrollment No",
      "type": "text",
      "required": true,
      "unique": true,
      "messages": {
        "required": "Enrollment No is required",
        "unique": "Enrollment No already exists"
      }
    },
    {
      "name": "email",
      "label": "Email",
      "type": "email",
      "required": true,
      "unique": true,
      "validation": {
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
      },
      "messages": {
        "required": "Email is required",
        "invalid": "Please enter a valid email address",
        "unique": "Email already exists"
      }
    },
    {
      "name": "mobile",
      "label": "Mobile",
      "type": "text",
      "required": true,
      "validation": {
        "pattern": "^[0-9]{10}$"
      },
      "messages": {
        "required": "Mobile is required",
        "invalid": "Mobile must contain exactly 10 digits"
      }
    },
    {
      "name": "dateOfBirth",
      "label": "Date of Birth",
      "type": "date",
      "required": true,
      "messages": {
        "required": "Date of Birth is required"
      }
    },
    {
      "name": "age",
      "label": "Age",
      "type": "number",
      "required": true,
      "validation": {
        "min": 18,
        "max": 60
      },
      "messages": {
        "required": "Age is required",
        "min": "Age must be at least 18",
        "max": "Age must not exceed 60"
      }
    },
    {
      "name": "gender",
      "label": "Gender",
      "type": "select",
      "required": true,
      "options": [
        "Male",
        "Female",
        "Other"
      ],
      "messages": {
        "required": "Gender is required",
        "invalid": "Gender must be Male, Female or Other"
      }
    },
    {
      "name": "course",
      "label": "Course",
      "type": "select",
      "required": true,
      "options": [
        "B.Sc. IT",
        "BCA",
        "B.Tech",
        "MCA",
        "M.Sc. IT"
      ],
      "messages": {
        "required": "Course is required"
      }
    },
    {
      "name": "specialization",
      "label": "Specialization",
      "type": "text",
      "required": true,
      "messages": {
        "required": "Specialization is required"
      }
    },
    {
      "name": "semester",
      "label": "Semester",
      "type": "number",
      "required": true,
      "validation": {
        "min": 1,
        "max": 6
      },
      "messages": {
        "required": "Semester is required",
        "min": "Semester must be between 1 and 6",
        "max": "Semester must be between 1 and 6"
      }
    },
    {
      "name": "address",
      "label": "Address",
      "type": "text",
      "required": true,
      "messages": {
        "required": "Address is required"
      }
    },
    {
      "name": "city",
      "label": "City",
      "type": "text",
      "required": true,
      "messages": {
        "required": "City is required"
      }
    },
    {
      "name": "state",
      "label": "State",
      "type": "text",
      "required": true,
      "messages": {
        "required": "State is required"
      }
    },
    {
      "name": "skills",
      "label": "Skills",
      "type": "radio",
      "required": true,
      "options": [
        "Java",
        "JavaScript",
        "Python",
        "C",
        "C++",
        "HTML",
        "CSS",
        "SQL"
      ],
      "messages": {
        "required": "Select at least one skill"
      }
    },
    {
      "name": "hobbies",
      "label": "Hobbies",
      "type": "radio",
      "required": true,
      "options": [
        "Reading",
        "Music",
        "Gaming",
        "Travel",
        "Sports",
        "Photography"
      ],
      "messages": {
        "required": "Select at least one hobby"
      }
    },
    {
      "name": "passportPhoto",
      "label": "Passport Photo",
      "type": "file",
      "required": true,
      "validation": {
        "allowedTypes": [
          "image/jpeg",
          "image/png"
        ],
        "maxSize": 2097152
      },
      "messages": {
        "required": "Passport Photo is required",
        "invalidType": "Only JPG and PNG images are allowed",
        "maxSize": "Passport Photo must not exceed 2 MB"
      }
    }
  ]
}